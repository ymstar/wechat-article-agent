# Coze 平台配置
COZE_WORKLOAD_IDENTITY_API_KEY=your_coze_api_key_here
COZE_INTEGRATION_MODEL_BASE_URL=https://api.coze.cn/v3

# 微信公众号配置（可选，也可以在 config/agent_llm_config.json 中配置）
WECHAT_APP_ID=wx1234567890abcdef
WECHAT_APP_SECRET=your_wechat_app_secret_here

# 日志配置
LOG_LEVEL=INFO

# API 配置
TIMEOUT_SECONDS=900
